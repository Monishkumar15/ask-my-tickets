# Copy this file to .env and fill in your own GEMINI_API_KEY and
# GROQ_API_KEY. Every other value below is a safe, working default --
# change only if you know you need to.

# Gemini is tried first by default (free tier via Google AI Studio).
# Get a key at https://aistudio.google.com/api-keys
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
GEMINI_MODEL_ID=gemini-3.1-flash-lite

# Groq is the automatic fallback -- used only if Gemini returns a 429
# (quota/rate-limit). Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL_ID=openai/gpt-oss-20b

# "gemini" or "groq" -- which provider is tried first. The app's UI toggle
# overrides this per-request; this is just the starting default.
DEFAULT_LLM_PROVIDER=gemini

# How random/deterministic answers are (0 = deterministic, higher = more
# varied wording). 1.0 is the OpenAI-compatible API's own default. The UI
# slider overrides this per-request.
DEFAULT_TEMPERATURE=1.0

DISTANCE_THRESHOLD=0.75
DIVERSIFY_MARGIN=0.3
MAX_DIVERSIFY_SOURCES=6

# When a reranked rerank_score is available, a source's best chunk must be
# within this margin of the BEST rerank_score found to still count as
# "genuinely relevant" for diversification -- catches a source that slips
# under the distance-based checks above by raw embedding distance alone
# while the cross-encoder (a more discerning signal) considers it clearly
# off-topic. Must be a relative margin, not an absolute floor -- a flat
# floor wrongly excludes every topic in a genuinely 3+-topic question,
# since the cross-encoder's confidence for each sub-topic gets diluted by
# reading one long compound question at once.
RERANK_RELEVANCE_MARGIN=6.0
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
QUERY_INSTRUCTION=
DATA_DIR=data
CHUNK_SIZE=300
OVERLAP_SENTENCES=1
QDRANT_URL=http://localhost:6333
COLLECTION_NAME=support_tickets
DEFAULT_TOP_K=3

# How many extra candidates semantic_retrieve() (the standalone Week 3
# baseline, not the live pipeline) pulls before narrowing to top_k.
CANDIDATE_POOL_MULTIPLIER=4

# Reciprocal Rank Fusion's damping constant -- standard value from Cormack
# et al., "Reciprocal Rank Fusion". Change only if you know what you're doing.
RRF_K=60

# How many candidates semantic search and BM25 each contribute before RRF
# fusion in hybrid_retrieve().
HYBRID_CANDIDATE_POOL=15

EMBED_DIM=384
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATE_POOL=10

# --- Local storage (Week 5) ---
TRACE_DIR=traces
SESSIONS_DIR=sessions

# --- API server ---
# Comma-separated origins the backend accepts browser requests from. Only
# matters if the frontend is hosted on its own origin with no proxy in
# front of it -- the Vite dev server's proxy and the built dist/ served by
# this same API both sidestep CORS entirely.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Agent loop (Week 7) ---
# Hard stop conditions for agent.py's ReAct loop, so a loop where the model
# picks its own next step can't run forever or cost unboundedly. 90s was
# calibrated against a real measured worst case (5 steps, cold model load):
# see config.py's comment for the actual numbers.
AGENT_MAX_STEPS=5
AGENT_MAX_SECONDS=90

# --- MCP server (Week 9) ---
# "http" (default) runs mcp_server.py as its own long-lived process, like
# Qdrant -- keeps its embedding model / BM25 index warm across calls.
# "stdio" launches it as a local subprocess instead -- no network exposure,
# used for the one-time raw-JSON-RPC inspection / zero-infra demo.
MCP_TRANSPORT=http
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8830
MCP_SERVER_URL=http://127.0.0.1:8830/mcp

# Required on every HTTP tool call (not stdio, which has no network
# exposure to gate). Generate your own locally, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
MCP_SHARED_SECRET=change-me-generate-a-real-secret-locally
